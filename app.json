{
  "expo": {
    "name": "Vitax",
    "slug": "Vitax",
    "version": "1.0.0",
    "scheme": "vitax",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1117",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitax.app"
    },
    "android": {
      "package": "com.vitax.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D1117",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "Vitax",
      "shortName": "Vitax",
      "themeColor": "#FF5500",
      "backgroundColor": "#080C14",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-document-picker",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Vitax à accéder à vos photos pour définir votre photo de profil.",
          "cameraPermission": "Autoriser Vitax à utiliser votre appareil photo pour prendre un selfie de profil."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c436d299-e9bd-4fae-a4e9-54fea42a8835"
      },
      "supabaseUrl": "https://ssotxhjqdoayzutvwbvy.supabase.co",
      "supabaseAnonKey": "sb_publishable_dZztFWFSoawAVnJaRhdB7g_jk0-2bld"
    },
    "owner": "pymatth",
    "updates": {
      "url": "https://u.expo.dev/c436d299-e9bd-4fae-a4e9-54fea42a8835"
    }
  }
}
